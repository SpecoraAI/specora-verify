{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpecoraAI/specora-verify/docs/schemas/certification-attestation-v1.0.json",
  "title": "Specora Certification Attestation v1.0",
  "description": "Normative JSON Schema for the certification-attestation canonical payload, Specora Wire Spec v1.0 §2.6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "tier",
    "integration",
    "issued_at",
    "requirements_met",
    "requirements_missing",
    "evidence_hashes",
    "ci_badges",
    "proof_surface_url",
    "verified_by",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "spec_id": {"type": "string", "enum": ["certification-attestation"]},
    "tier": {"type": "string", "enum": ["enterprise"]},
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor_id", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vendor_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {"type": "string", "minLength": 1}
      }
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "requirements_met": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "requirements_missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "description": "Object whose keys name evidence artifacts and whose values are SHA-256 hex digests of their canonical forms. Reference keys: anchor_payload, anchor_receipt, attestation_manifest, meta, proof_manifest, verification_output."
    },
    "ci_badges": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "proof_surface_url": {"type": "string", "minLength": 1},
    "verified_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specora_verify_version", "node_verifier_commit"],
      "properties": {
        "specora_verify_version": {"type": "string", "minLength": 1},
        "node_verifier_commit": {"type": "string", "minLength": 1}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
