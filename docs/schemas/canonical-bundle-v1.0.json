{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpecoraAI/specora-verify/docs/schemas/canonical-bundle-v1.0.json",
  "title": "Specora Canonical Evidence Bundle v1.0",
  "description": "Normative JSON Schema for the in-memory canonical evidence bundle produced by provider readers and the platform-side normalizer. Complements Wire Spec v1.0 (which describes the on-the-wire serialization of attestation/proof manifests and anchor payloads). A canonical evidence bundle is the shape every provider reader's bundle_payload satisfies before signing and ledger persistence. See docs/canonical-bundle-schema-v1.0.md for the human-readable companion and canonicalization rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "records"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "reader",
        "reader_version",
        "key_id",
        "upstream_schema_version",
        "record_count",
        "content_hash"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider identifier (matches the reader registry key, e.g. 'anthropic', 'cloudtrail')."
        },
        "reader": {
          "type": "string",
          "pattern": "^specora_verify\\.readers\\.[a-z0-9_]+$",
          "description": "Fully-qualified reader module path."
        },
        "reader_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Reader SemVer version."
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Specora signing key ID under which this bundle will be signed."
        },
        "upstream_schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Upstream provider schema version observed during the read."
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records in the bundle. MUST equal len(records)."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of canonical_json_bytes({\"records\": records}), with the 'sha256:' prefix. Computed via the Frozen Canonicalizer v1.0.0."
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "timestamp", "model", "decision", "context", "upstream_signature"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable upstream record identifier."
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "RFC 3339 UTC with mandatory Z suffix, no fractional seconds."
        },
        "upstream_request_id": { "type": "string" },
        "upstream_event_name": { "type": "string" },
        "aws_region": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string" }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "policy_refs"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["approved", "rejected", "deferred", "escalated"]
            },
            "policy_refs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "formal_verdict": { "type": "string", "minLength": 1 },
            "proof_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "constraints": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash"],
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "upstream_signature": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["alg", "key_id", "value"],
              "properties": {
                "alg": { "type": "string", "enum": ["ed25519"] },
                "key_id": { "type": "string" },
                "value": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["absent_per_record", "integrity_mechanism"],
              "properties": {
                "absent_per_record": { "type": "boolean", "const": true },
                "integrity_mechanism": { "type": "string", "minLength": 1 },
                "digest_file_ref": { "type": "string" }
              }
            }
          ]
        },
        "tool_invocations": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
