{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpecoraAI/specora-verify/docs/schemas/stp-certification-attestation-v1.0.json",
  "title": "Specora STP Certification Attestation v1.0",
  "description": "Normative JSON Schema for the stp-certification-attestation canonical payload, Specora Wire Spec v1.0 §2.7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "tier",
    "protocol_version",
    "adapter",
    "issuer_key_id",
    "bundle_root_hash",
    "evidence_hashes",
    "requirements_met",
    "requirements_missing",
    "proof_surface_url",
    "issued_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "spec_id": {"type": "string", "enum": ["stp-certification-attestation"]},
    "tier": {"type": "string", "enum": ["compatible"]},
    "protocol_version": {"type": "string", "enum": ["1.0.0"]},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "issuer_key_id": {"type": "string", "minLength": 1},
    "bundle_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "requirements_met": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "requirements_missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "proof_surface_url": {"type": "string", "minLength": 1},
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
