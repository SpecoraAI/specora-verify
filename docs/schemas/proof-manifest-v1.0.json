{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpecoraAI/specora-verify/docs/schemas/proof-manifest-v1.0.json",
  "title": "Specora Proof Manifest v1.0",
  "description": "Normative JSON Schema for the proof-manifest canonical payload, Specora Wire Spec v1.0 §2.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "org_id", "period_start", "period_end", "leaf_count", "root_hash", "root_type", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "org_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "period_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "period_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "leaf_count": {
      "type": "integer",
      "minimum": 0
    },
    "root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 Merkle root over ledger leaves."
    },
    "root_type": {
      "type": "string",
      "enum": ["daily"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
