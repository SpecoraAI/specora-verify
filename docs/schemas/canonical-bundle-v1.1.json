{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SpecoraAI/specora-verify/docs/schemas/canonical-bundle-v1.1.json",
  "title": "Specora Canonical Evidence Bundle v1.1 (additive over v1.0)",
  "description": "Wire Spec v1.1 — additive extension of v1.0 that introduces an OPTIONAL agent_identity claim on each records[] entry. v1.0 bundles validate cleanly under v1.1 (adoption is opt-in). The agent_identity envelope shape is the demo-lane Specora cert format documented at specora-aid-cert-v1-demo. Investor-demo lane only (CSEA-SUPPRESS-2026-05-08-002 in the platform repo); production format will rev to a non -demo suffix when the C01 ceremony root + Big 4 engagement land.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "records"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "reader",
        "reader_version",
        "key_id",
        "upstream_schema_version",
        "record_count",
        "content_hash"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider identifier (matches the reader registry key)."
        },
        "reader": {
          "type": "string",
          "pattern": "^specora_verify\\.readers\\.[a-z0-9_]+$",
          "description": "Fully-qualified reader module path."
        },
        "reader_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Reader SemVer version."
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Specora signing key ID under which this bundle will be signed."
        },
        "upstream_schema_version": {
          "type": "string",
          "minLength": 1,
          "description": "Upstream provider schema version observed during the read."
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records in the bundle. MUST equal len(records)."
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of canonical_json_bytes({\"records\": records}), with the 'sha256:' prefix. Computed via the Frozen Canonicalizer v1.0.0."
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "timestamp", "model", "decision", "context", "upstream_signature"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upstream_request_id": { "type": "string" },
        "upstream_event_name": { "type": "string" },
        "aws_region": { "type": "string", "minLength": 1 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string" }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "policy_refs"],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["approved", "rejected", "deferred", "escalated"]
            },
            "policy_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "formal_verdict": { "type": "string", "minLength": 1 },
            "proof_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "constraints": { "type": "array", "items": { "type": "string" } }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash"],
          "properties": {
            "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "upstream_signature": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["alg", "key_id", "value"],
              "properties": {
                "alg": { "type": "string", "enum": ["ed25519"] },
                "key_id": { "type": "string" },
                "value": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["absent_per_record", "integrity_mechanism"],
              "properties": {
                "absent_per_record": { "type": "boolean", "const": true },
                "integrity_mechanism": { "type": "string", "minLength": 1 },
                "digest_file_ref": { "type": "string" }
              }
            }
          ]
        },
        "tool_invocations": { "type": "array", "items": { "type": "object" } },
        "agent_identity": {
          "$ref": "#/$defs/agent_identity_envelope",
          "description": "OPTIONAL. Demo-lane Specora-issued agent identity certificate envelope. When absent, the verifier ignores the field. When present, the verifier validates the envelope per the rules documented in docs/wire-spec-v1.1.md §3.2 and surfaces a FAIL verdict on tampering."
        }
      }
    },
    "agent_identity_envelope": {
      "type": "object",
      "required": [
        "format",
        "subject",
        "issuer",
        "public_key",
        "issuer_key_fingerprint",
        "issued_at",
        "not_after",
        "signature"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "const": "specora-aid-cert-v1-demo",
          "description": "Wire identifier. The '-demo' suffix is load-bearing. Production format carries a different suffix; relying parties MUST refuse anything else."
        },
        "subject": {
          "type": "object",
          "required": ["identity_id", "org_id", "agent_id"],
          "additionalProperties": false,
          "properties": {
            "identity_id": { "type": "string", "minLength": 1 },
            "org_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "string", "minLength": 1 }
          }
        },
        "issuer": {
          "type": "object",
          "required": ["common_name", "organizational_unit", "organization"],
          "additionalProperties": false,
          "properties": {
            "common_name": { "type": "string", "minLength": 1 },
            "organizational_unit": { "type": "string", "minLength": 1 },
            "organization": { "type": "string", "minLength": 1 }
          }
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hex-encoded Ed25519 public key bound by the certificate."
        },
        "issuer_key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the issuer's raw 32-byte public key, hex-encoded."
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "not_after": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Base64-encoded Ed25519 signature over canonical JSON of the envelope minus this field."
        }
      }
    }
  }
}
